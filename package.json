{
  "devDependencies": {
    "prettier": "^3.9.9"
  },
  "name": "my-spotify-stats",
  "private": true,
  "scripts": {
    "setup": "npm ci --prefix bases",
    "start": "npm start --prefix bases",
    "build": "npm run build --prefix bases",
    "test": "npm test --prefix bases -- --watch=false --browsers=ChromeHeadless",
    "format": "prettier --write \"bases/src/**/*.{ts,html,css}\" \"bases/*.{json,cjs}\" \"*.md\" \"docs/*.md\"",
    "format:check": "prettier --check \"bases/src/**/*.{ts,html,css}\" \"bases/*.{json,cjs}\" \"*.md\" \"docs/*.md\""
  }
}
